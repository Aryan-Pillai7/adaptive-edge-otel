# ---------------------------------------------------------------------------
# adaptive-edge-otel — local configuration
#
#   cp .env.example .env
#
# Every value here has a working default. You should be able to bring the whole
# stack up without editing a single line.
# ---------------------------------------------------------------------------

# --- Image pins ------------------------------------------------------------
# Pinned deliberately: an observability pipeline that silently changes processor
# behaviour on a `docker compose pull` is not reproducible. Bump intentionally.
COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.159.0
TELEMETRYGEN_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:v0.159.0
VICTORIAMETRICS_IMAGE=victoriametrics/victoria-metrics:v1.111.0
LOKI_IMAGE=grafana/loki:3.3.2
TEMPO_IMAGE=grafana/tempo:2.7.0
GRAFANA_IMAGE=grafana/grafana:11.4.0
# Used by scripts/lint.sh when the shellcheck binary is not installed.
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0

# --- Collector ---------------------------------------------------------------
# Which config the Collector runs. This is the switch between the two arms of the
# experiment, so a before/after run is one variable, not an edit:
#   collector.passthrough.yaml  -> "before": no sampling, no dedup, no attr stripping
#   collector.yaml              -> "after":  the smart pipeline (Phase 4)
COLLECTOR_CONFIG=collector.passthrough.yaml

# --- Host ports ------------------------------------------------------------
# The Collector is the ONLY component that accepts telemetry, so it owns 4317/4318.
# Tempo deliberately gets no host port: its native 4317 would collide with the
# Collector's OTLP receiver. The Collector reaches it over the compose network.
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
COLLECTOR_METRICS_PORT=8888       # Collector's own self-telemetry (pipeline throughput)
COLLECTOR_HEALTH_PORT=13133       # health_check extension (probed from the host)
VICTORIAMETRICS_PORT=8428         # VM's native port, not remapped to 9090
LOKI_PORT=3100
TEMPO_QUERY_PORT=3200             # query API only; ingest is network-internal
APP_PORT=8000
GRAFANA_PORT=3000                 # only bound under `--profile ui`

# --- Memory budgets --------------------------------------------------------
# The thesis of this project is that edge processing keeps backends small, so the
# budgets are enforced, not aspirational. If a backend OOMs, the pipeline upstream
# is not doing its job — raise the limit only after checking why.
VM_MEM_LIMIT=200m
LOKI_MEM_LIMIT=200m
TEMPO_MEM_LIMIT=200m
COLLECTOR_MEM_LIMIT=256m
APP_MEM_LIMIT=192m

# Collector's in-process memory_limiter. Kept below COLLECTOR_MEM_LIMIT so the
# processor sheds load and backpressures the SDK before Docker hard-kills the
# container. Graceful refusal beats an OOM kill.
COLLECTOR_MEMORY_LIMIT_MIB=192
COLLECTOR_MEMORY_SPIKE_MIB=48

# --- Retention -------------------------------------------------------------
# Short by design: this is a demo stack, not a system of record.
VM_RETENTION_PERIOD=3d

# --- Tail sampling (Phase 4) ----------------------------------------------
# 100% of errors, 100% of slow traces, and a thin probabilistic slice of healthy
# traffic. The baseline slice is NOT zero on purpose: a service with no traces
# when healthy gives you nothing to compare an incident against.
TAIL_SAMPLING_ERROR_PCT=100
TAIL_SAMPLING_SLOW_THRESHOLD_MS=500
TAIL_SAMPLING_BASELINE_PCT=5
# How long the Collector buffers a trace before deciding. Must exceed your slowest
# expected request or slow traces get judged on incomplete data.
TAIL_SAMPLING_DECISION_WAIT=10s

# --- Application behaviour (Phase 3) --------------------------------------
OTEL_SERVICE_NAME=edge-demo-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
APP_ERROR_RATE=0.05                # fraction of /api/* requests that return 500
APP_LOG_LEVEL=INFO

# Flood profile: the simulated incident (DB timeout -> log spam + cardinality blowup)
FLOOD_DURATION_SECONDS=30
FLOOD_LOGS_PER_SECOND=500          # identical log records — what logdedup collapses
FLOOD_UNIQUE_LABELS_PER_SECOND=200 # unique tag values — what transform strips
